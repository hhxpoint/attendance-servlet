<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>职工考勤管理系统</display-name>
    <description>基于Java Servlet的职工考勤管理系统</description>

    <!-- Servlet声明 -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.attendance.servlet.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/user/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AttendanceServlet</servlet-name>
        <servlet-class>com.attendance.servlet.AttendanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttendanceServlet</servlet-name>
        <url-pattern>/attendance/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DepartmentServlet</servlet-name>
        <servlet-class>com.attendance.servlet.DepartmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DepartmentServlet</servlet-name>
        <url-pattern>/dept/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AnnouncementServlet</servlet-name>
        <servlet-class>com.attendance.servlet.AnnouncementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AnnouncementServlet</servlet-name>
        <url-pattern>/announcement/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LeaveServlet</servlet-name>
        <servlet-class>com.attendance.servlet.LeaveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeaveServlet</servlet-name>
        <url-pattern>/leave/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.attendance.servlet.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>

    <!-- 欢迎页面 -->
    <welcome-file-list>
        <welcome-file>static/login.html</welcome-file>
    </welcome-file-list>

    <!-- Session配置 -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- 字符编码过滤器 -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.attendance.filter.CharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 登录验证过滤器 -->
    <filter>
        <filter-name>LoginFilter</filter-name>
        <filter-class>com.attendance.filter.LoginFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LoginFilter</filter-name>
        <url-pattern>/user/*</url-pattern>
        <url-pattern>/attendance/*</url-pattern>
        <url-pattern>/dept/*</url-pattern>
        <url-pattern>/leave/*</url-pattern>
        <url-pattern>/announcement/*</url-pattern>
    </filter-mapping>

    <!-- 应用监听器 -->
    <listener>
        <listener-class>com.attendance.listener.AppListener</listener-class>
    </listener>
    <listener>
        <listener-class>com.attendance.listener.SessionListener</listener-class>
    </listener>

    <!-- 错误页面配置 -->
    <error-page>
        <error-code>404</error-code>
        <location>/static/error.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/static/error.html</location>
    </error-page>

</web-app>
